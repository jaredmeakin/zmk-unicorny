#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Corne 6-row keyboard
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

#define SEARCH LS(LC(LA(LG(F20))))
#define ZMK_POINTING_DEFAULT_MOVE_VAL 3000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mmv { };

/ {
    // ╭──────────────────────────────────────────────────────────╮
    // │ ⚡ COMBOS                                                     │
    // ╰──────────────────────────────────────────────────────────╯
    combos {
        compatible = "zmk,combos";

        // ─── NAV: PREV (Cmd + [) ──────────────────
        // Action: Navigate backward in browser/IDE.
        // Right Hand Top: [ Y ] [ U ]
        prev {
            bindings = <&kp LG(LEFT_BRACKET)>;
            key-positions = <7 6>;
        };

        // ─── NAV: NEXT (Cmd + ]) ──────────────────
        // Action: Navigate forward in browser/IDE.
        // Right Hand Top: [ U ] [ I ]
        next {
            bindings = <&kp LG(RIGHT_BRACKET)>;
            key-positions = <8 7>;
        };

        // ─── EDIT: DELETE ─────────────────────────
        // Action: Standard forward delete.
        // Right Hand Top: [ P ] [BSPC]
        del {
            bindings = <&kp DELETE>;
            key-positions = <11 10>;
        };

        // ─── LAYER: BLUETOOTH PAIRING ─────────────
        // Action: Activate Bluetooth sticky layer.
        // Right Hand Top: [ I ] [ O ] [ P ] [BSPC]
        bt {
            bindings = <&sl 4>;
            key-positions = <11 10 9 8>;
        };

        // ─── SYSTEM: BOOTLOADER ───────────────────
        // Action: Enter flashing mode.
        // Left Hand Top: [ W ] [ E ] [ R ] [ T ]
        boot {
            bindings = <&bootloader>;
            key-positions = <5 4 3 2>;
            layers = <0>;
        };

        // ─── KEY: ESCAPE ──────────────────────────
        // Action: Standard Escape key.
        // Left Thumbs:  [ L1 ] [ L2 ]
        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <38 37>;
        };

        // ─── NAV: SEEK (Alt + Ctrl + F10) ──────────
        // Action: Media seek or custom IDE shortcut.
        // Right Thumbs: [ENT ] [ -  ]
        seek {
            bindings = <&kp LA(LC(F10))>;
            key-positions = <39 40>;
        };

        // ─── IDE: PREVIOUS METHOD ─────────────────
        // Action: Jump to previous code block.
        // Left Hand Top: [ E ] [ R ]
        prev_method {
            bindings = <&kp LS(LC(UP_ARROW))>;
            key-positions = <4 3>;
        };

        // ─── IDE: NEXT METHOD ─────────────────────
        // Action: Jump to next code block.
        // Left Hand Top: [ R ] [ T ]
        next_method {
            bindings = <&kp LS(LC(DOWN))>;
            key-positions = <4 5>;
        };

        // ─── LAYER: ENTER MOUSE MODE ──────────────
        // Action: Switch to mouse control layer.
        // Left Thumbs:  [ L0 ] [ L1 ]
        to-mouse {
            bindings = <&to 3>;
            key-positions = <37 36>;
            layers = <0 1 2 4 5>;
        };

        // ─── LAYER: EXIT MOUSE MODE ───────────────
        // Action: Return to base from mouse layer.
        // Left Thumbs:  [ L0 ] [ L1 ]
        to-base-from-mouse {
            bindings = <&to 0>;
            key-positions = <37 36>;
            layers = <3>;
        };
    };

    // ╭──────────────────────────────────────────────────────────╮
    // │ ⚙️ BEHAVIORS                                                  │
    // ╰──────────────────────────────────────────────────────────╯
    behaviors {
        hrml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hrmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    // ╭──────────────────────────────────────────────────────────╮
    // │ ⌨️ KEYMAP                                                     │
    // ╰──────────────────────────────────────────────────────────╯
    keymap {
        compatible = "zmk,keymap";

        // ─── LAYER 0: BASE ⌨️ ───────────────────────────────────────────
        // home row mods, boi!
        base {
            bindings = <
                &kp GRAVE &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BSPC
                &kp TAB &hrml LCTRL A &hrml LALT S &hrml LGUI D &hrml LSHIFT F &kp G &kp H &hrmr LSHIFT J &hrmr LGUI K &hrmr LALT L &hrmr LCTRL SEMI &kp SQT
                &caps_word &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp BACKSLASH
                &to 1 &to 2 &kp SPACE &kp ENTER &kp MINUS &kp EQUAL
            >;
        };

        // ─── LAYER 1: NAV 🧭 ────────────────────────────────────────────
        // move around lines with arrows keys, and make the left + right click available
        // as the key code for the context menu doesn't always triggr it. this allows you to
        // navigate around words, and than right click to do things like correct spelling
        nav {
            bindings = <
                &trans &trans &trans &trans &trans &trans &none &mkp LCLK &kp UP &mkp RCLK &none &trans
                &trans &trans &trans &trans &trans &trans &kp HOME &kp LEFT &kp DOWN &kp RIGHT &kp END &none
                &trans &trans &trans &trans &trans &trans &none &none &trans &trans &trans &trans
                &to 0 &to 2 &trans &trans &trans &trans
            >;
        };

        // ─── LAYER 2: CODE 💻 ───────────────────────────────────────────
        // left hand has numbers with 1 starting at Q spanning the first and second rows with G as 0
        // right hand has symbols with only asterisk and percent, being less used, on the left hand
        // both hands have home row mods
        code {
            bindings = <
                &trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp LEFT_BRACE &kp RIGHT_BRACE &kp EXCLAMATION &kp AT &kp HASH &trans
                &trans &hrml LEFT_ALT NUMBER_6 &hrml LCTRL N7 &hrml LEFT_COMMAND N8 &hrml LEFT_SHIFT N9 &kp N0 &kp LEFT_PARENTHESIS &hrmr LEFT_SHIFT RIGHT_PARENTHESIS &hrmr LEFT_GUI DOLLAR &hrmr LEFT_ALT AMPERSAND &hrmr LEFT_CONTROL SEMI &trans
                &trans &trans &trans &trans &kp ASTERISK &kp PERCENT &kp LEFT_BRACKET &kp RIGHT_BRACKET &trans &trans &trans &trans
                &to 1 &to 0 &trans &trans &trans &trans
            >;
        };

        // ─── LAYER 3: MOUSE 🖱️ ──────────────────────────────────────────
        // navigate with right hand, and click with right thumb-cluster
        // leaves left hand open for home row operations like ⌘ + C
        mouse {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &msc SCRL_DOWN &mmv MOVE_UP &msc SCRL_UP &none &trans
                &trans &trans &trans &trans &trans &trans &msc SCRL_LEFT &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_RIGHT &none
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        // ─── LAYER 4: BLUETOOTH 📶 ──────────────────────────────────────
        bluetooth {
            bindings = <
                &none &none &none &none &none &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_SEL 5
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &bt BT_CLR
                &to 0 &to 0 &none &none &none &none
            >;
        };
    };
};